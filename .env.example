DATABASE_URL=postgresql://bank_ai_user:change_me@localhost:5432/bank_ai_lab

SECURITY_POLICY_PATH=config/security_policy.yml
PERSIST_DECISIONS=true
APP_NAME=Bank AI Antifraud DLP Lab
APP_VERSION=0.3.0